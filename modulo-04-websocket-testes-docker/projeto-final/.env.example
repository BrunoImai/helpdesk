# Copie para ".env" e preencha. O ".env" NUNCA é versionado nem entra na imagem Docker.
APP_NAME=HelpDesk API
DEBUG=true

# --- Rodando SEM Docker (uvicorn na sua máquina) ---
# Mongo local (docker run -d -p 27017:27017 mongo:7) ou a string do MongoDB Atlas.
# --- Rodando com docker compose ---
# O compose ignora MONGO_URI e usa o Mongo do próprio compose (mongodb://mongo:27017).
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=helpdesk

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-gerada-com-secrets-token-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
