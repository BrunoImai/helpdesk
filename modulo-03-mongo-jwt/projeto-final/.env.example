# Copie para ".env" e preencha. O ".env" NUNCA é versionado.
APP_NAME=HelpDesk API
DEBUG=true

# Mongo instalado na máquina (mongodb://localhost:27017) ou a string do MongoDB Atlas:
#   mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=helpdesk

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-gerada-com-secrets-token-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
