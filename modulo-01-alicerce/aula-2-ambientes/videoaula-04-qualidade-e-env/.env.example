# Copie este arquivo para ".env" e preencha os valores reais.
# O arquivo ".env" NUNCA deve ser versionado.

APP_NAME=HelpDesk
DEBUG=true

# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-gerada

# Usado a partir do Módulo 3
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=helpdesk
